rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
//  ShapeUp — Reglas de seguridad de Firestore (v2)
//  Auth por whitelist de miembros (misma familia que "Comida Familiar").
//  Colecciones de dominio de ejercicio + módulo de salud + recomendaciones.
// ════════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // Resuelve el memberId del que llama buscando su email en /config/familia.
    function resolveMemberId() {
      let familia = get(/databases/$(database)/documents/config/familia).data;
      let email = request.auth.token.email.lower();
      return familia.miembros.juanpablo.mails.hasAny([email]) ? "juanpablo" :
             familia.miembros.maria.mails.hasAny([email]) ? "maria" :
             familia.miembros.sofia.mails.hasAny([email]) ? "sofia" :
             familia.miembros.federico.mails.hasAny([email]) ? "federico" : null;
    }
    function isFamilyMember() {
      return request.auth != null && resolveMemberId() != null;
    }
    function isOwner() {
      let memberId = resolveMemberId();
      return request.auth != null && memberId != null
        && get(/databases/$(database)/documents/config/familia).data.owner == memberId;
    }

    // Catálogo de ejercicios: curado por el owner; lectura para miembros.
    match /ejercicios/{id} {
      allow read: if isFamilyMember();
      allow write: if isOwner();
    }

    // Rutinas, programas: cualquier miembro (la visibilidad filtra en la app).
    match /rutinas/{id}   { allow read, write: if isFamilyMember(); }
    match /programas/{id} { allow read, write: if isFamilyMember(); }

    // Sesiones: cualquier miembro crea/actualiza; el borrado es solo de lo propio.
    match /sesiones/{id} {
      allow read, create, update: if isFamilyMember();
      allow delete: if isFamilyMember() && resource.data.miembro == resolveMemberId();
    }

    // Historial (log real) con media opcional (fotos/notas del entrenamiento).
    // El borrado es solo de lo propio (un miembro no puede borrar el historial de otro).
    match /historial/{id} {
      allow read, create, update: if isFamilyMember();
      allow delete: if isFamilyMember() && resource.data.miembro == resolveMemberId();
      match /media/{mediaId} { allow read, write: if isFamilyMember(); }
    }

    // Módulo de salud: composición, cardio/FC y recomendaciones.
    match /mediciones/{id}      { allow read, write: if isFamilyMember(); }
    match /cardio/{id}          { allow read, write: if isFamilyMember(); }
    match /sueno/{id}              { allow read, write: if isFamilyMember(); }
    match /metricas-salud/{id}    { allow read, write: if isFamilyMember(); }
    match /recomendaciones/{id}   { allow read, write: if isFamilyMember(); }

    // Perfiles: cada miembro edita el suyo (equipo disponible, objetivos, zonas FC, color).
    match /config/perfiles { allow read, write: if isFamilyMember(); }
    // Parámetros del import de salud (umbral de duración, actividades) — P75.
    // Se lee como el resto de /config y se escribe como /config/perfiles. Se edita
    // en Perfil → Configuración (P86), y no vale la pena reservarlo al owner.
    match /config/import { allow read, write: if isFamilyMember(); }
    // Programa activo por miembro: cada miembro puede activar su propio programa.
    match /config/programaActivo { allow read, write: if isFamilyMember(); }
    // Visibilidad: la controla el owner (qué programa/rutina ve cada miembro).
    match /config/visibilidad {
      allow read: if isFamilyMember();
      allow write: if isOwner();
    }
    // Resto de config (familia, diccionarios, metodologia): lee miembro, escribe owner.
    match /config/{docId} {
      allow read: if isFamilyMember();
      allow write: if isOwner();
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && isFamilyMember();
      allow update: if isFamilyMember() && (request.auth.uid == uid || isOwner());
      allow delete: if isOwner();
    }

    // Ingesta cruda del puente Android (PU2). Solo el propio usuario, por uid.
    // El puente vuelca crudo; el adaptador TS (PU4) lo interpreta.
    match /ingesta-sdk/{uid}/registros/{docId} {
      // Registros partidos (PU3): `parte` y `totalPartes` son opcionales; si vienen,
      // vienen los dos, son int y 1 <= parte <= totalPartes <= 50.
      function sinPartes(d) {
        return !('parte' in d) && !('totalPartes' in d);
      }
      function partesValidas(d) {
        return 'parte' in d && 'totalPartes' in d
          && d.parte is int && d.totalPartes is int
          && d.parte >= 1 && d.parte <= d.totalPartes && d.totalPartes <= 50;
      }

      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && isFamilyMember()
        && request.resource.data.keys().hasOnly(
             ['dataType', 'uidSamsung', 'leidoMs', 'versionPuente', 'crudo',
              'parte', 'totalPartes'])
        && (sinPartes(request.resource.data) || partesValidas(request.resource.data))
        && request.resource.data.crudo is string
        && request.resource.data.crudo.size() < 1000000
        && request.resource.data.dataType is string
        && request.resource.data.uidSamsung is string;
    }

    // Estado del puente. Tres documentos, cada uno con su lista de campos cerrada:
    //  - "puente"      (PU3): la última corrida. Lo escribe el puente.
    //  - "pedido"      (P89): ShapeUp le pide una corrida al puente.
    //  - "dispositivo" (P89/P90): el token FCM del puente. Lo escribe el puente,
    //    y `ultimoPushMs` lo escribe la Cloud Function (con Admin SDK).
    // Ojo: `request.resource.data` es el documento DESPUÉS del merge, así que
    // `ultimoPushMs` tiene que estar en la lista de "dispositivo" aunque el
    // puente no lo escriba: si no, su próxima escritura se rechaza en silencio.
    match /ingesta-sdk/{uid}/estado/{docId} {
      function esDueno() {
        return request.auth != null && request.auth.uid == uid && isFamilyMember();
      }
      function intSiEsta(d, campo) {
        return !(campo in d) || d[campo] is int;
      }
      function stringSiEsta(d, campo) {
        return !(campo in d) || d[campo] is string;
      }
      function puenteValido(d) {
        return d.keys().hasOnly([
               'ultimaCorridaMs', 'versionPuente', 'origen',
               'leidos', 'subidos', 'sinCambios', 'omitidos', 'errores',
               'duracionMs', 'mensaje'])
          && d.ultimaCorridaMs is int
          && d.origen in ['manual', 'segundo-plano', 'pedido'];
      }
      function pedidoValido(d) {
        return d.keys().hasOnly(['pedidoMs', 'origen'])
          && d.pedidoMs is int
          && d.origen in ['boton', 'fin-sesion', 'automatica'];
      }
      function dispositivoValido(d) {
        return d.keys().hasOnly(['fcmToken', 'actualizadoMs', 'modelo', 'versionPuente', 'ultimoPushMs'])
          && stringSiEsta(d, 'fcmToken')
          && intSiEsta(d, 'actualizadoMs')
          && stringSiEsta(d, 'modelo')
          && stringSiEsta(d, 'versionPuente')
          && intSiEsta(d, 'ultimoPushMs');
      }

      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if esDueno() && (
           (docId == 'puente'      && puenteValido(request.resource.data))
        || (docId == 'pedido'      && pedidoValido(request.resource.data))
        || (docId == 'dispositivo' && dispositivoValido(request.resource.data)));
    }
  }
}
