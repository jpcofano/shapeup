{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.tsc-out/tsconfig.app.tsbuildinfo",
    "outDir": "./.tsc-out/app",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // functions/src/pedido.ts es puro y la app importa de ahí MIN_ENTRE_PUSH_MS (P91):
  // una sola fuente para el "un pedido por minuto" de los dos lados.
  "include": ["src", "functions/src/pedido.ts"]
}
